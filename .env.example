# MongoDB Atlas — Database > Connect > Drivers (free M0 tier is plenty)
MONGODB_URI=
MONGODB_DB=tracker

# Firebase Auth — Project settings > General > "Your apps" (web app config).
# These reach the browser; they identify the project, they don't authorize it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Firebase Admin — Project settings > Service accounts > "Generate new private key".
# Keep the private key's \n escapes and wrap the whole value in double quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# TMDB — https://www.themoviedb.org/settings/api ("API Read Access Token", the long v4 one)
TMDB_API_TOKEN=

# Base URL of the app (change to your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
